{
  "name": "ely-tesia",
  "version": "1.0.9",
  "description": "Ely-Tesia — Sintetizador y visualizador interactivo de piano y archivos MIDI para Windows y Android",
  "private": true,
  "scripts": {
    "dev": "gradlew.bat :composeApp:run",
    "dev:desktop": "gradlew.bat :composeApp:run",
    "dev:android": "gradlew.bat :composeApp:installDebug",
    "test": "gradlew.bat :composeApp:desktopTest",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1 local",
    "build:desktop": "gradlew.bat :composeApp:packageExe",
    "build:android": "gradlew.bat :composeApp:assembleRelease",
    "build:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1 local",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1 local",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1 local -SkipAndroid",
    "release:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1 local -SkipWindows",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-release.ps1"
  },
  "keywords": [
    "midi",
    "piano",
    "synthesizer",
    "compose-multiplatform",
    "kotlin-multiplatform",
    "android",
    "desktop"
  ],
  "author": "biglexj (2026)",
  "license": "MIT"
}
